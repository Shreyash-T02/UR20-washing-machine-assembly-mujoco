<?xml version="1.0"?>
<!--
  Assembly-cell scene — processed with Xacro, output to /tmp/wm_assembly_scene.xml at launch time.

  ╔════════════════════════════════════════════════════════════════════╗
  ║  CONFIGURABLE DIMENSIONS  ← edit only this block                  ║
  ║  Change any property once and the whole scene updates at launch.  ║
  ╚════════════════════════════════════════════════════════════════════╝
-->
<mujoco model="ur20_assembly_cell" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Absolute path to wm_ur20_description/meshes — injected by launch file -->
  <xacro:arg name="meshdir"
    default="/ros2_ws/install/wm_ur20_description/share/wm_ur20_description/meshes"/>

  <!-- Absolute path to wm_cell_description/meshes — injected by launch file -->
  <xacro:arg name="cell_meshdir"
    default="/ros2_ws/install/wm_cell_description/share/wm_cell_description/meshes"/>

  <!-- ══════════════════════════════════════════════════════════════════
       CONFIGURABLE DIMENSIONS
       ══════════════════════════════════════════════════════════════════ -->

  <!-- Robot mount pillar (square cross-section, robot base sits on top) -->
  <xacro:property name="pillar_half_side" value="0.25"/>  <!-- m — half width of each face -->
  <xacro:property name="pillar_h"         value="0.90"/>  <!-- m — floor to robot base -->

  <!-- Work table (placed on the +Y side of the pillar) -->
  <xacro:property name="table_l"     value="1.60"/>  <!-- m — full length along X -->
  <xacro:property name="table_w"     value="1.40"/>  <!-- m — full depth  along Y -->
  <xacro:property name="table_h"     value="0.90"/>  <!-- m — floor to table surface -->
  <xacro:property name="table_top_t" value="0.04"/>  <!-- m — tabletop thickness -->
  <xacro:property name="table_leg_r" value="0.03"/>  <!-- m — leg cylinder radius -->

  <!-- Conveyor belt (runs in front of robot on the −Y side) -->
  <xacro:property name="conv_l"       value="4.00"/>  <!-- m — visible belt length along X -->
  <xacro:property name="conv_w"       value="0.90"/>  <!-- m — belt width along Y -->
  <xacro:property name="conv_h"       value="0.50"/>  <!-- m — floor to belt surface -->
  <xacro:property name="conv_leg_r"   value="0.04"/>  <!-- m — support leg radius -->
  <xacro:property name="conv_frame_t" value="0.03"/>  <!-- m — side-rail half-thickness -->

  <!-- ══════════════════════════════════════════════════════════════════
       DERIVED LAYOUT  (computed — do not edit)
       ══════════════════════════════════════════════════════════════════ -->

  <xacro:property name="table_cy" value="${pillar_half_side + 0.20 + table_w/2}"/>
  <xacro:property name="conv_cy"  value="${-(pillar_half_side + 0.20 + conv_w/2)}"/>

  <xacro:property name="tleg_ox" value="${table_l/2 - table_leg_r - 0.02}"/>
  <xacro:property name="tleg_oy" value="${table_w/2 - table_leg_r - 0.02}"/>
  <xacro:property name="tleg_h"  value="${table_h - table_top_t}"/>

  <xacro:property name="cleg_ox" value="${conv_l/2 - conv_leg_r - 0.05}"/>
  <xacro:property name="cleg_oy" value="${conv_w/2 - conv_leg_r - 0.02}"/>
  <xacro:property name="cleg_h"  value="${conv_h - conv_frame_t}"/>

  <!-- ══════════════════════════════════════════════════════════════════
       MUJOCO GLOBAL SETTINGS
       ══════════════════════════════════════════════════════════════════ -->

  <compiler angle="radian" meshdir="$(arg meshdir)" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.5 0.5 0.5"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <mesh name="base_col"     file="collision/base.stl"/>
    <mesh name="shoulder_col" file="collision/shoulder.stl"/>
    <mesh name="upperarm_col" file="collision/upperarm.stl"/>
    <mesh name="forearm_col"  file="collision/forearm.stl"/>
    <mesh name="wrist1_col"   file="collision/wrist1.stl"/>
    <mesh name="wrist2_col"   file="collision/wrist2.stl"/>
    <mesh name="wrist3_col"   file="collision/wrist3.stl"/>
    <mesh name="base_vis"     file="visual/base.obj"/>
    <mesh name="shoulder_vis" file="visual/shoulder.obj"/>
    <mesh name="upperarm_vis" file="visual/upperarm.obj"/>
    <mesh name="forearm_vis"  file="visual/forearm.obj"/>
    <mesh name="wrist1_vis"   file="visual/wrist1.obj"/>
    <mesh name="wrist2_vis"   file="visual/wrist2.obj"/>
    <mesh name="wrist3_vis"   file="visual/wrist3.obj"/>

    <!-- OnRobot 2FG14 gripper meshes (collision used for both rendering and contact) -->
    <mesh name="gripper_base1_col"  file="collision/2FG14_basep1.STL"/>
    <mesh name="gripper_base2_col"  file="collision/2FG14_basep2.STL"/>
    <mesh name="gripper_base3_col"  file="collision/2FG14_basep3.STL"/>
    <mesh name="gripper_finger_col" file="collision/2FG14_gripper_finger.STL"/>

    <!-- Washing-machine part meshes (STL coords are in metres — no scale needed) -->
    <mesh name="kit_mesh"      file="$(arg cell_meshdir)/fixtures/assembly_kit.STL"/>
    <mesh name="wm_shaft"      file="$(arg cell_meshdir)/parts/washingmachine_shaft_directdrive.STL"/>
    <mesh name="wm_motor"      file="$(arg cell_meshdir)/parts/washingmachine_motorsubassem.STL"/>
    <mesh name="wm_pump"       file="$(arg cell_meshdir)/parts/washingmachine_pump.STL"/>
    <mesh name="wm_inverter"   file="$(arg cell_meshdir)/parts/washingmachine_invertercntrl.STL"/>
    <mesh name="wm_counter"    file="$(arg cell_meshdir)/parts/washingmachine_counterweight.STL"/>
    <mesh name="wm_jig"        file="$(arg cell_meshdir)/parts/washingmachine_assemblyjigfortrunion.STL"/>
    <mesh name="wm_innerdrum"  file="$(arg cell_meshdir)/parts/washingmachine_innerdrum_col.STL"/>
    <mesh name="wm_outerdrum"  file="$(arg cell_meshdir)/parts/washingmachine_outerdrum.STL"/>
    <mesh name="wm_agitator"   file="$(arg cell_meshdir)/parts/washingmachine_agitator.STL"/>
    <mesh name="wm_floor_pan"  file="$(arg cell_meshdir)/parts/washingmachine_floor.STL"/>
    <mesh name="wm_trunion"    file="$(arg cell_meshdir)/parts/washingmachine_trunionwithpivotdome.STL"/>

    <material name="ur_metal"      rgba="0.27 0.27 0.27 1" specular="0.85" shininess="0.75" reflectance="0.10"/>
    <material name="ur_link"       rgba="0.33 0.33 0.33 1" specular="0.70" shininess="0.60" reflectance="0.05"/>
    <material name="floor_mat"     rgba="0.45 0.45 0.45 1" specular="0.10" shininess="0.10"/>
    <material name="pillar_mat"    rgba="0.50 0.50 0.55 1" specular="0.60" shininess="0.50"/>
    <material name="table_mat"     rgba="0.80 0.72 0.58 1" specular="0.30" shininess="0.40"/>
    <material name="frame_mat"     rgba="0.35 0.35 0.40 1" specular="0.50" shininess="0.40"/>
    <material name="belt_mat"      rgba="0.12 0.12 0.12 1" specular="0.20" shininess="0.20"/>
    <material name="blue_plastic"  rgba="0.10 0.10 0.80 1" specular="0.10" shininess="0.10"/>
    <material name="black_plastic" rgba="0.10 0.10 0.10 1" specular="0.10" shininess="0.10"/>
    <material name="drum_cap_mat"  rgba="0.85 0.15 0.15 1" specular="0.20" shininess="0.30"/>
    <material name="wm_steel"      rgba="0.70 0.70 0.75 1" specular="0.80" shininess="0.70"/>
    <material name="wm_plastic"    rgba="0.88 0.88 0.88 1" specular="0.30" shininess="0.40"/>
    <material name="wm_kit"        rgba="0.78 0.68 0.48 1" specular="0.20" shininess="0.20"/>
    <material name="wm_elec"       rgba="0.15 0.55 0.20 1" specular="0.20" shininess="0.30"/>
  </asset>

  <contact>
    <exclude body1="world"          body2="shoulder_link"/>
    <exclude body1="shoulder_link"  body2="upper_arm_link"/>
    <exclude body1="upper_arm_link" body2="forearm_link"/>
    <exclude body1="forearm_link"   body2="wrist_1_link"/>
    <exclude body1="wrist_1_link"   body2="wrist_2_link"/>
    <exclude body1="wrist_2_link"   body2="wrist_3_link"/>
    <exclude body1="wrist_3_link"   body2="gripper"/>
    <exclude body1="gripper"        body2="finger_left"/>
    <exclude body1="gripper"        body2="finger_right"/>
  </contact>

  <worldbody>

    <light name="key"  pos="2 -2 4"  dir="-0.4 0.4 -1"  diffuse="0.8 0.8 0.8"    specular="0.4 0.4 0.4"   castshadow="true"/>
    <light name="fill" pos="-3  2 3" dir="0.5 -0.3 -1"  diffuse="0.35 0.35 0.35" specular="0.1 0.1 0.1"   castshadow="false"/>

    <geom name="floor" type="plane" size="8 8 0.1" material="floor_mat" contype="1" conaffinity="1"/>

    <!-- ════════════════════════════════════════
         ROBOT MOUNT PILLAR
         Robot base at Z = pillar_h; shoulder at Z = pillar_h + 0.2363 (d1 of UR20).
         To change height: edit pillar_h above.
         ════════════════════════════════════════ -->
    <geom name="pillar"
          type="box"
          pos="0 0 ${pillar_h/2}"
          size="${pillar_half_side} ${pillar_half_side} ${pillar_h/2}"
          material="pillar_mat" contype="1" conaffinity="1"/>

    <geom name="base_vis"
          pos="0 0 ${pillar_h}" quat="-1 0 0 0"
          type="mesh" mesh="base_vis"
          group="0" material="ur_metal" contype="0" conaffinity="0"/>
    <geom name="base_col"
          pos="0 0 ${pillar_h}" quat="-1 0 0 0"
          type="mesh" mesh="base_col"
          group="3" contype="1" conaffinity="1"/>

    <!-- ════════════════════════════════════════
         UR20 ARM
         ════════════════════════════════════════ -->
    <body name="shoulder_link" pos="0 0 ${pillar_h + 0.2363}" quat="0 0 0 1">
      <inertial pos="0 -0.0062 -0.061" quat="0.843524 0.480626 0.117639 -0.208871"
                mass="16.343" diaginertia="0.0887394 0.0883735 0.0720472"/>
      <joint name="shoulder_pan_joint"  pos="0 0 0" axis="0 0 1"
             range="-6.28319 6.28319" actuatorfrcrange="-738 738" armature="0.1" damping="500"/>
      <geom name="shoulder_vis" quat="0 0 0 1" type="mesh" mesh="shoulder_vis" group="0" material="ur_metal" contype="0" conaffinity="0"/>
      <geom name="shoulder_col" quat="0 0 0 1" type="mesh" mesh="shoulder_col" group="3" contype="1" conaffinity="1"/>

      <body name="upper_arm_link" quat="0.707107 0.707107 0 0">
        <inertial pos="-0.3394 0 0.2098" quat="0.502566 0.497435 0.496798 0.503168"
                  mass="29.632" diaginertia="4.6659 4.63539 0.146106"/>
        <joint name="shoulder_lift_joint" pos="0 0 0" axis="0 0 1"
               range="-6.28319 6.28319" actuatorfrcrange="-738 738" armature="0.1" damping="500"/>
        <geom name="upperarm_vis" pos="0 0 0.26" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="upperarm_vis" group="0" material="ur_link" contype="0" conaffinity="0"/>
        <geom name="upperarm_col" pos="0 0 0.26" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="upperarm_col" group="3" contype="1" conaffinity="1"/>

        <body name="forearm_link" pos="-0.862 0 0">
          <inertial pos="-0.4053 0 0.0604" quat="0.510462 0.48933 0.490588 0.509223"
                    mass="7.879" diaginertia="0.75763 0.754423 0.0249668"/>
          <joint name="elbow_joint" pos="0 0 0" axis="0 0 1"
                 range="-3.14159 3.14159" actuatorfrcrange="-433 433" armature="0.1" damping="300"/>
          <geom name="forearm_vis" pos="0 0 0.043" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="forearm_vis" group="0" material="ur_link" contype="0" conaffinity="0"/>
          <geom name="forearm_col" pos="0 0 0.043" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="forearm_col" group="3" contype="1" conaffinity="1"/>

          <body name="wrist_1_link" pos="-0.7287 0 0.201">
            <inertial pos="0 -0.0393 -0.0026" quat="0.989529 0.121355 0.0147064 -0.0767408"
                      mass="3.054" diaginertia="0.00555247 0.00545771 0.00392982"/>
            <joint name="wrist_1_joint" pos="0 0 0" axis="0 0 1"
                   range="-6.28319 6.28319" armature="0.05" damping="80"/>
            <geom name="wrist1_vis" pos="0 0 -0.0775" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist1_vis" group="0" material="ur_metal" contype="0" conaffinity="0"/>
            <geom name="wrist1_col" pos="0 0 -0.0775" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist1_col" group="3" contype="1" conaffinity="1"/>

            <body name="wrist_2_link" pos="0 -0.1593 0" quat="0.707107 0.707107 0 0">
              <inertial pos="0 0.0379 -0.0024" quat="0.489074 -0.0502817 0.102168 0.864777"
                        mass="3.126" diaginertia="0.00586894 0.00585713 0.00418393"/>
              <joint name="wrist_2_joint" pos="0 0 0" axis="0 0 1"
                     range="-6.28319 6.28319" armature="0.05" damping="80"/>
              <geom name="wrist2_vis" pos="0 0 -0.0749" quat="1 0 0 0" type="mesh" mesh="wrist2_vis" group="0" material="ur_metal" contype="0" conaffinity="0"/>
              <geom name="wrist2_col" pos="0 0 -0.0749" quat="1 0 0 0" type="mesh" mesh="wrist2_col" group="3" contype="1" conaffinity="1"/>

              <body name="wrist_3_link" pos="0 0.1543 0" quat="0.707107 -0.707107 0 0">
                <inertial pos="0 0 -0.0293" quat="0.5 0.5 -0.5 0.5"
                          mass="0.926" diaginertia="0.00117 0.00092 0.00091"/>
                <joint name="wrist_3_joint" pos="0 0 0" axis="0 0 1"
                       range="-6.28319 6.28319" armature="0.05" damping="40"/>
                <geom name="wrist3_vis" pos="0 0 -0.07" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist3_vis" group="0" material="ur_metal" contype="0" conaffinity="0"/>
                <geom name="wrist3_col" pos="0 0 -0.07" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist3_col" group="3" contype="1" conaffinity="1"/>
                <site name="ee_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>

                <!-- ════════════════════════════════════════
                     OnRobot 2FG14 GRIPPER
                     Attached to wrist_3_link.
                     One actuator drives finger_left_slide; equality couples finger_right.
                     ctrl range: 0.00245 m (closed) → 0.028 m (fully open).
                     To open:  pub 0.028 to /gripper_position_controller/commands
                     To close: pub 0.00245 to /gripper_position_controller/commands
                     ════════════════════════════════════════ -->
                <!-- contype/conaffinity=0 on all gripper geoms: visual only, no collision.
                     Avoids mesh-mesh contact explosion that hangs the MuJoCo RT loop.
                     Fingertip box geoms are the only collision-active geometry — small,
                     analytically cheap, and sufficient for Phase 6 grasping. -->
                <body name="gripper" pos="0 0 0" quat="1 0 0 0">
                  <geom name="gripper_base1" pos="0 0 0" quat="1 0 0 0"
                        type="mesh" mesh="gripper_base1_col"
                        group="0" material="blue_plastic"
                        contype="0" conaffinity="0" density="2200"/>
                  <geom name="gripper_base2" pos="0 0 0.013" quat="1 0 0 0"
                        type="mesh" mesh="gripper_base2_col"
                        group="0" material="ur_metal"
                        contype="0" conaffinity="0" density="5000"/>
                  <geom name="gripper_base3" pos="0 0 0.103" quat="0.707107 0 0 0.707107"
                        type="mesh" mesh="gripper_base3_col"
                        group="0" material="ur_metal"
                        contype="0" conaffinity="0" density="5000"/>

                  <body name="finger_left" pos="0 -0.0025 0.1137" quat="1 0 0 0">
                    <joint name="finger_left_slide" type="slide" pos="0 0 0" axis="0 -1 0"
                           range="-0.04 0.04" damping="50"/>
                    <geom name="finger_left_vis" pos="0 0 0" quat="1 0 0 0"
                          type="mesh" mesh="gripper_finger_col"
                          group="0" material="blue_plastic"
                          contype="0" conaffinity="0" density="5000"/>
                    <geom name="finger_left_tip" pos="0 -0.015 0.065" size="0.008 0.008 0.012"
                          type="box" group="3"
                          friction="1.5 0.05 0.01" contype="1" conaffinity="1"/>
                    <site name="finger_left_tip_site" pos="0 -0.015 0.069" size="0.005" rgba="1 0 0 1"/>
                  </body>

                  <body name="finger_right" pos="0 0.0025 0.1137" quat="0 0 0 1">
                    <joint name="finger_right_slide" type="slide" pos="0 0 0" axis="0 -1 0"
                           range="-0.04 0.04" damping="50"/>
                    <geom name="finger_right_vis" pos="0 0 0" quat="1 0 0 0"
                          type="mesh" mesh="gripper_finger_col"
                          group="0" material="blue_plastic"
                          contype="0" conaffinity="0" density="5000"/>
                    <geom name="finger_right_tip" pos="0 -0.015 0.065" size="0.008 0.008 0.012"
                          type="box" group="3"
                          friction="1.5 0.05 0.01" contype="1" conaffinity="1"/>
                    <site name="finger_right_tip_site" pos="0 -0.015 0.069" size="0.005" rgba="0 1 0 1"/>
                  </body>
                </body>

              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ════════════════════════════════════════
         WORK TABLE  (+Y side of pillar)
         To change size: edit table_l / table_w / table_h above.
         ════════════════════════════════════════ -->
    <geom name="table_leg_xp_yn" type="cylinder"
          pos="${tleg_ox}  ${table_cy - tleg_oy} ${tleg_h/2}"
          size="${table_leg_r} ${tleg_h/2}" material="table_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_xp_yp" type="cylinder"
          pos="${tleg_ox}  ${table_cy + tleg_oy} ${tleg_h/2}"
          size="${table_leg_r} ${tleg_h/2}" material="table_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_xn_yn" type="cylinder"
          pos="${-tleg_ox} ${table_cy - tleg_oy} ${tleg_h/2}"
          size="${table_leg_r} ${tleg_h/2}" material="table_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_xn_yp" type="cylinder"
          pos="${-tleg_ox} ${table_cy + tleg_oy} ${tleg_h/2}"
          size="${table_leg_r} ${tleg_h/2}" material="table_mat" contype="1" conaffinity="1"/>
    <geom name="table_top"
          type="box"
          pos="0 ${table_cy} ${table_h - table_top_t/2}"
          size="${table_l/2} ${table_w/2} ${table_top_t/2}"
          material="table_mat" contype="1" conaffinity="1"/>

    <!-- ════════════════════════════════════════
         CONVEYOR BELT  (−Y side of pillar)
         To change size: edit conv_l / conv_w / conv_h above.
         Belt direction: +X = forward (towards human station); −X = return.
         Control via /conveyor_velocity_controller/commands (Float64MultiArray, m/s).
         Note: the belt_surface body drifts along X during operation. The belt geom
         is 8× conv_l so the visible area stays covered for ~3 min at 0.5 m/s.
         ════════════════════════════════════════ -->

    <!-- Support legs (4 corners) -->
    <geom name="conv_leg_xp_yn" type="cylinder"
          pos="${cleg_ox}  ${conv_cy - cleg_oy} ${cleg_h/2}"
          size="${conv_leg_r} ${cleg_h/2}" material="frame_mat" contype="1" conaffinity="1"/>
    <geom name="conv_leg_xp_yp" type="cylinder"
          pos="${cleg_ox}  ${conv_cy + cleg_oy} ${cleg_h/2}"
          size="${conv_leg_r} ${cleg_h/2}" material="frame_mat" contype="1" conaffinity="1"/>
    <geom name="conv_leg_xn_yn" type="cylinder"
          pos="${-cleg_ox} ${conv_cy - cleg_oy} ${cleg_h/2}"
          size="${conv_leg_r} ${cleg_h/2}" material="frame_mat" contype="1" conaffinity="1"/>
    <geom name="conv_leg_xn_yp" type="cylinder"
          pos="${-cleg_ox} ${conv_cy + cleg_oy} ${cleg_h/2}"
          size="${conv_leg_r} ${cleg_h/2}" material="frame_mat" contype="1" conaffinity="1"/>

    <!-- Side rails -->
    <geom name="conv_rail_yn"
          type="box"
          pos="0 ${conv_cy - conv_w/2 + conv_frame_t/2} ${conv_h - conv_frame_t/2}"
          size="${conv_l/2} ${conv_frame_t/2} ${conv_frame_t/2}"
          material="frame_mat" contype="1" conaffinity="1"/>
    <geom name="conv_rail_yp"
          type="box"
          pos="0 ${conv_cy + conv_w/2 - conv_frame_t/2} ${conv_h - conv_frame_t/2}"
          size="${conv_l/2} ${conv_frame_t/2} ${conv_frame_t/2}"
          material="frame_mat" contype="1" conaffinity="1"/>

    <!-- Belt surface body — slides along X axis, drags objects via friction -->
    <body name="belt_surface" pos="0 ${conv_cy} ${conv_h}">
      <joint name="belt_slide" type="slide" axis="1 0 0"
             range="-100 100" damping="50"/>
      <geom name="belt_geom"
            type="box"
            size="${conv_l * 4} ${conv_w/2 - conv_frame_t} 0.005"
            material="belt_mat"
            friction="1.5 0.05 0.01"
            condim="4"
            contype="1" conaffinity="1"/>
    </body>

    <!-- ════════════════════════════════════════
         ASSEMBLY FLOOR — WM floor pan, the assembly base on the conveyor.
         Pre-positioned at x=0 (directly in front of robot); belt not used.
         freejoint so the robot can push/place parts onto it.
         mesh Z[−0.007, 0.050] → body_z = conv_h + 0.007 sets bottom at belt surface.
         ════════════════════════════════════════ -->
    <body name="wm_floor_part" pos="0 ${conv_cy} ${conv_h + 0.007}">
      <freejoint/>
      <geom name="wm_floor_geom" type="mesh" mesh="wm_floor_pan"
            quat="0.7071 0 0 -0.7071"
            material="wm_plastic"
            mass="3.0"
            friction="0.8 0.05 0.01" condim="4"
            contype="1" conaffinity="1"/>
    </body>

    <!-- ════════════════════════════════════════
         ASSEMBLY KIT — parts tray lying flat, LONG side facing robot.
         Combined rotation (+90° X then +90° Z) = quat (0.5 0.5 0.5 0.5).
           maps: Z→X (1.3 m now runs along table X — the long side faces robot)
                 X→Y (1.1 m now runs along table depth Y)
                 Y→Z (0.4 m becomes the height — kit lies flat)
         Body origin:
           kit bottom (Z_new = Y_old_min = 0) on table surface → body_z = table_h
           kit centred in X: new X_ctr = −Z_old_ctr = −0.05 → body_x = +0.05
           kit centred in Y: new Y_ctr = −X_old_ctr = +0.05 → body_y = table_cy−0.05
         Kit world footprint: X∈[−0.65,0.65]  Y∈[0.60,1.70]  Z∈[0.90,1.30]
         (table is 1.60×1.40 m → 15 cm clearance on all four sides)
         ════════════════════════════════════════ -->
    <body name="assembly_kit" pos="0.05 ${table_cy - 0.05} ${table_h}" quat="0.5 0.5 -0.5 -0.5">
      <geom name="kit_geom" type="mesh" mesh="kit_mesh"
            material="wm_kit"
            contype="0" conaffinity="0"/>
    </body>

    <!-- ════════════════════════════════════════
         ASSEMBLY PARTS — 11 parts on kit surface, original grey materials, −90° Z rotation.
         MuJoCo quat (w x y z) = 0.7071 0 0 -0.7071.  All parts visual only (contype=0).
         After −90° Z rot: world_X=[bx+mesh_Ymin, bx+mesh_Ymax], world_Y=[by−mesh_Xmax, by−mesh_Xmin].
         All footprints verified non-overlapping, within kit X∈[−0.600,0.700] Y∈[0.550,1.650].

         Layout (rows, front-to-back):
           FRONT  (y≈0.65–0.96): outerdrum(−0.307,0.807) | pump(0.044,0.650) | innerdrum(0.293,0.757) | shaft(0.530,0.800) | jig1(0.631,0.700)
           MID    (y≈0.95–1.25): jig2(0.631,0.950) | agitator(0.293,1.110) | jig3(0.631,1.160)
           BACK   (y≈1.33–1.60): trunion(−0.311,1.330) | motor(0.020,1.365) | counter(0.480,1.395) | inverter(0.200,1.500)
         ════════════════════════════════════════ -->

    <!-- SHAFT — grippable (⌀48 mm fits 2FG14); clear of innerdrum X-range -->
    <body name="shaft_part"        pos=" 0.530  0.800 1.300" quat="0.7071 0 0 -0.7071">
      <geom name="shaft_vis"         type="mesh" mesh="wm_shaft"    material="wm_steel"   contype="0" conaffinity="0"/>
    </body>

    <!-- FRONT ROW — large drums at minimum Y, side-by-side in X -->
    <body name="wm_outerdrum_part" pos="-0.307  0.807 1.387" quat="0.7071 0 0 -0.7071">
      <geom name="wm_outerdrum_geom" type="mesh" mesh="wm_outerdrum" material="wm_plastic" contype="0" conaffinity="0"/>
    </body>
    <body name="wm_innerdrum_part" pos=" 0.293  0.757 1.404" quat="0.7071 0 0 -0.7071">
      <geom name="wm_innerdrum_geom" type="mesh" mesh="wm_innerdrum" material="wm_steel"   contype="0" conaffinity="0"/>
    </body>

    <!-- PUMP — fits in X-gap between drums (world_X=[−0.057,0.071]) -->
    <body name="wm_pump_part"      pos=" 0.044  0.650 1.300" quat="0.7071 0 0 -0.7071">
      <geom name="wm_pump_geom"      type="mesh" mesh="wm_pump"     material="wm_plastic" contype="0" conaffinity="0"/>
    </body>

    <!-- RIGHT COLUMN — three jigs stacked vertically at kit right edge -->
    <body name="wm_jig_part_1"     pos=" 0.631  0.700 1.300" quat="0.7071 0 0 -0.7071">
      <geom name="wm_jig_geom_1"     type="mesh" mesh="wm_jig"      material="wm_plastic" contype="0" conaffinity="0"/>
    </body>
    <body name="wm_jig_part_2"     pos=" 0.631  0.950 1.300" quat="0.7071 0 0 -0.7071">
      <geom name="wm_jig_geom_2"     type="mesh" mesh="wm_jig"      material="wm_plastic" contype="0" conaffinity="0"/>
    </body>
    <body name="wm_jig_part_3"     pos=" 0.631  1.160 1.300" quat="0.7071 0 0 -0.7071">
      <geom name="wm_jig_geom_3"     type="mesh" mesh="wm_jig"      material="wm_plastic" contype="0" conaffinity="0"/>
    </body>

    <!-- MID ROW — agitator above innerdrum -->
    <body name="wm_agitator_part"  pos=" 0.293  1.110 1.395" quat="0.7071 0 0 -0.7071">
      <geom name="wm_agitator_geom"  type="mesh" mesh="wm_agitator" material="wm_plastic" contype="0" conaffinity="0"/>
    </body>

    <!-- BACK ROW — large trunion left, motor+counter+inverter right -->
    <body name="wm_trunion_part"   pos="-0.311  1.330 1.551" quat="0.7071 0 0 -0.7071">
      <geom name="wm_trunion_geom"   type="mesh" mesh="wm_trunion"  material="wm_steel"   contype="0" conaffinity="0"/>
    </body>
    <body name="wm_motor_part"     pos=" 0.020  1.365 1.331" quat="0.7071 0 0 -0.7071">
      <geom name="wm_motor_geom"     type="mesh" mesh="wm_motor"    material="wm_steel"   contype="0" conaffinity="0"/>
    </body>
    <body name="wm_counter_part"   pos=" 0.480  1.395 1.451" quat="0.7071 0 0 -0.7071">
      <geom name="wm_counter_geom"   type="mesh" mesh="wm_counter"  material="wm_steel"   contype="0" conaffinity="0"/>
    </body>
    <body name="wm_inverter_part"  pos=" 0.200  1.500 1.300" quat="0.7071 0 0 -0.7071">
      <geom name="wm_inverter_geom"  type="mesh" mesh="wm_inverter" material="wm_elec"    contype="0" conaffinity="0"/>
    </body>


    <!-- Pick-site marker — visual cross on belt surface at x=0, y=conv_cy -->
    <body name="pick_marker" pos="0.0 ${conv_cy} ${conv_h + 0.001}">
      <geom name="pick_x" type="box" pos="0 0 0" size="0.040 0.005 0.001"
            rgba="1 1 0 0.7" contype="0" conaffinity="0"/>
      <geom name="pick_y" type="box" pos="0 0 0" size="0.005 0.040 0.001"
            rgba="1 1 0 0.7" contype="0" conaffinity="0"/>
    </body>

  </worldbody>

  <!-- ════════════════════════════════════════
       ACTUATORS
       ════════════════════════════════════════ -->
  <actuator>
    <!-- kv=0 required: MujocoSystem classifies by biasprm[2]==0 → POSITION type -->
    <position name="shoulder_pan"  joint="shoulder_pan_joint"  kp="12000" ctrlrange="-6.28319 6.28319"/>
    <position name="shoulder_lift" joint="shoulder_lift_joint" kp="12000" ctrlrange="-6.28319 6.28319"/>
    <position name="elbow"         joint="elbow_joint"         kp="8000"  ctrlrange="-3.14159 3.14159"/>
    <position name="wrist_1"       joint="wrist_1_joint"       kp="3000"  ctrlrange="-6.28319 6.28319"/>
    <position name="wrist_2"       joint="wrist_2_joint"       kp="3000"  ctrlrange="-6.28319 6.28319"/>
    <position name="wrist_3"       joint="wrist_3_joint"       kp="1500"  ctrlrange="-6.28319 6.28319"/>

    <!-- Belt: velocity-controlled (m/s).  +X = forward toward human station. -->
    <velocity name="belt_motor" joint="belt_slide" kv="2000" ctrlrange="-1.0 1.0"/>

    <!-- Gripper: position-controlled. Drives finger_left_slide; equality couples finger_right.
         0.00245 m = closed,  0.028 m = fully open -->
    <position name="fingers" joint="finger_left_slide" kp="2000" ctrlrange="0.00245 0.028"/>
  </actuator>

  <!-- Equality: finger_right body has quat="0 0 0 1" (180° Z rotation), which flips its
       joint axis from (0,-1,0) to (0,+1,0) in the parent frame. So polycoef="0 1 ..."
       (q_right = q_left) produces symmetric symmetric motion: left goes -Y, right goes +Y. -->
  <equality>
    <joint name="fingers_eq"
           joint1="finger_left_slide" joint2="finger_right_slide"
           polycoef="0 1 0 0 0"
           solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </equality>

  <!-- qpos order (depth-first): 6 arm joints, finger_left, finger_right, belt_slide,
                                  wm_floor_part freejoint (x y z qw qx qy qz) = 16 values
       ctrl  order (actuator):   6 arm,        belt_motor,  fingers               = 8 values
       Gripper starts open (0.028 m); belt parked (0).
       Floor pre-positioned at x=0 in front of robot; body_z = conv_h+0.007 = 0.507. -->
  <keyframe>
    <key name="home"
         qpos="0 -1.5708 0 0 0 0  0.028 0.028  0  0 -0.90 0.507 1 0 0 0"
         ctrl="0 -1.5708 0 0 0 0  0  0.028"/>
  </keyframe>

</mujoco>
