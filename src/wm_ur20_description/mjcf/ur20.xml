<mujoco model="ur20">
  <compiler angle="radian" meshdir=".." autolimits="true"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7" specular="0.5 0.5 0.5"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <mesh name="base_col"     file="meshes/collision/base.stl"/>
    <mesh name="shoulder_col" file="meshes/collision/shoulder.stl"/>
    <mesh name="upperarm_col" file="meshes/collision/upperarm.stl"/>
    <mesh name="forearm_col"  file="meshes/collision/forearm.stl"/>
    <mesh name="wrist1_col"   file="meshes/collision/wrist1.stl"/>
    <mesh name="wrist2_col"   file="meshes/collision/wrist2.stl"/>
    <mesh name="wrist3_col"   file="meshes/collision/wrist3.stl"/>
    <mesh name="base_vis"     file="meshes/visual/base.obj"/>
    <mesh name="shoulder_vis" file="meshes/visual/shoulder.obj"/>
    <mesh name="upperarm_vis" file="meshes/visual/upperarm.obj"/>
    <mesh name="forearm_vis"  file="meshes/visual/forearm.obj"/>
    <mesh name="wrist1_vis"   file="meshes/visual/wrist1.obj"/>
    <mesh name="wrist2_vis"   file="meshes/visual/wrist2.obj"/>
    <mesh name="wrist3_vis"   file="meshes/visual/wrist3.obj"/>

    <material name="ur_metal"
              rgba="0.27 0.27 0.27 1"
              specular="0.85"
              shininess="0.75"
              reflectance="0.1"/>
    <material name="ur_link"
              rgba="0.33 0.33 0.33 1"
              specular="0.7"
              shininess="0.6"
              reflectance="0.05"/>
    <material name="floor_mat"
              rgba="0.45 0.45 0.45 1"
              specular="0.1"
              shininess="0.1"/>
  </asset>

  <contact>
    <exclude body1="world"          body2="shoulder_link"/>
    <exclude body1="shoulder_link"  body2="upper_arm_link"/>
    <exclude body1="upper_arm_link" body2="forearm_link"/>
    <exclude body1="forearm_link"   body2="wrist_1_link"/>
    <exclude body1="wrist_1_link"   body2="wrist_2_link"/>
    <exclude body1="wrist_2_link"   body2="wrist_3_link"/>
  </contact>

  <worldbody>
    <light name="key"  pos="1 -1 3"  dir="-0.3 0.3 -1" diffuse="0.8 0.8 0.8" specular="0.4 0.4 0.4" castshadow="true"/>
    <light name="fill" pos="-2 1 2"  dir="0.5 -0.3 -1" diffuse="0.35 0.35 0.35" specular="0.1 0.1 0.1" castshadow="false"/>

    <geom name="floor" type="plane" size="2 2 0.1" material="floor_mat" contype="1" conaffinity="1"/>

    <geom name="base_vis" pos="0 0 0" quat="-1 0 0 0" type="mesh" mesh="base_vis"
          group="0" material="ur_metal" contype="0" conaffinity="0"/>
    <geom name="base_col" pos="0 0 0" quat="-1 0 0 0" type="mesh" mesh="base_col"
          group="3" contype="1" conaffinity="1"/>

    <!-- shoulder_link z-height from official URDF d1 = 0.2363 m -->
    <body name="shoulder_link" pos="0 0 0.2363" quat="0 0 0 1">
      <inertial pos="0 -0.0062 -0.061" quat="0.843524 0.480626 0.117639 -0.208871"
                mass="16.343" diaginertia="0.0887394 0.0883735 0.0720472"/>
      <joint name="shoulder_pan_joint" pos="0 0 0" axis="0 0 1"
             range="-6.28319 6.28319" actuatorfrcrange="-738 738"
             armature="0.1" damping="500"/>
      <geom name="shoulder_vis" quat="0 0 0 1" type="mesh" mesh="shoulder_vis"
            group="0" material="ur_metal" contype="0" conaffinity="0"/>
      <geom name="shoulder_col" quat="0 0 0 1" type="mesh" mesh="shoulder_col"
            group="3" contype="1" conaffinity="1"/>

      <body name="upper_arm_link" quat="0.707107 0.707107 0 0">
        <inertial pos="-0.3394 0 0.2098" quat="0.502566 0.497435 0.496798 0.503168"
                  mass="29.632" diaginertia="4.6659 4.63539 0.146106"/>
        <joint name="shoulder_lift_joint" pos="0 0 0" axis="0 0 1"
               range="-6.28319 6.28319" actuatorfrcrange="-738 738"
               armature="0.1" damping="500"/>
        <geom name="upperarm_vis" pos="0 0 0.26" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="upperarm_vis"
              group="0" material="ur_link" contype="0" conaffinity="0"/>
        <geom name="upperarm_col" pos="0 0 0.26" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="upperarm_col"
              group="3" contype="1" conaffinity="1"/>

        <!-- forearm pos from official URDF a2 = -0.862 m -->
        <body name="forearm_link" pos="-0.862 0 0">
          <inertial pos="-0.4053 0 0.0604" quat="0.510462 0.48933 0.490588 0.509223"
                    mass="7.879" diaginertia="0.75763 0.754423 0.0249668"/>
          <joint name="elbow_joint" pos="0 0 0" axis="0 0 1"
                 range="-3.14159 3.14159" actuatorfrcrange="-433 433"
                 armature="0.1" damping="300"/>
          <geom name="forearm_vis" pos="0 0 0.043" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="forearm_vis"
                group="0" material="ur_link" contype="0" conaffinity="0"/>
          <geom name="forearm_col" pos="0 0 0.043" quat="0.5 0.5 -0.5 -0.5" type="mesh" mesh="forearm_col"
                group="3" contype="1" conaffinity="1"/>

          <!-- wrist_1 pos from official URDF a3=-0.7287, d4=0.201 -->
          <body name="wrist_1_link" pos="-0.7287 0 0.201">
            <inertial pos="0 -0.0393 -0.0026" quat="0.989529 0.121355 0.0147064 -0.0767408"
                      mass="3.054" diaginertia="0.00555247 0.00545771 0.00392982"/>
            <joint name="wrist_1_joint" pos="0 0 0" axis="0 0 1"
                   range="-6.28319 6.28319"
                   armature="0.05" damping="80"/>
            <geom name="wrist1_vis" pos="0 0 -0.0775" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist1_vis"
                  group="0" material="ur_metal" contype="0" conaffinity="0"/>
            <geom name="wrist1_col" pos="0 0 -0.0775" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist1_col"
                  group="3" contype="1" conaffinity="1"/>

            <!-- wrist_2 pos from official URDF d5=0.1593 -->
            <body name="wrist_2_link" pos="0 -0.1593 0" quat="0.707107 0.707107 0 0">
              <inertial pos="0 0.0379 -0.0024" quat="0.489074 -0.0502817 0.102168 0.864777"
                        mass="3.126" diaginertia="0.00586894 0.00585713 0.00418393"/>
              <joint name="wrist_2_joint" pos="0 0 0" axis="0 0 1"
                     range="-6.28319 6.28319"
                     armature="0.05" damping="80"/>
              <geom name="wrist2_vis" pos="0 0 -0.0749" quat="1 0 0 0" type="mesh" mesh="wrist2_vis"
                    group="0" material="ur_metal" contype="0" conaffinity="0"/>
              <geom name="wrist2_col" pos="0 0 -0.0749" quat="1 0 0 0" type="mesh" mesh="wrist2_col"
                    group="3" contype="1" conaffinity="1"/>

              <!-- wrist_3 pos from official URDF d6=0.1543 -->
              <body name="wrist_3_link" pos="0 0.1543 0" quat="0.707107 -0.707107 0 0">
                <inertial pos="0 0 -0.0293" quat="0.5 0.5 -0.5 0.5"
                          mass="0.926" diaginertia="0.00117 0.00092 0.00091"/>
                <joint name="wrist_3_joint" pos="0 0 0" axis="0 0 1"
                       range="-6.28319 6.28319"
                       armature="0.05" damping="40"/>
                <geom name="wrist3_vis" pos="0 0 -0.07" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist3_vis"
                      group="0" material="ur_metal" contype="0" conaffinity="0"/>
                <geom name="wrist3_col" pos="0 0 -0.07" quat="0.707107 0.707107 0 0" type="mesh" mesh="wrist3_col"
                      group="3" contype="1" conaffinity="1"/>
                <site name="ee_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- kv=0 required: MujocoSystem classifies actuators by biasprm[2]==0 for POSITION type.
         Velocity damping is handled by joint damping= attributes above. -->
    <position name="shoulder_pan"  joint="shoulder_pan_joint"  kp="12000" ctrlrange="-6.28319 6.28319"/>
    <position name="shoulder_lift" joint="shoulder_lift_joint" kp="12000" ctrlrange="-6.28319 6.28319"/>
    <position name="elbow"         joint="elbow_joint"         kp="8000"  ctrlrange="-3.14159 3.14159"/>
    <position name="wrist_1"       joint="wrist_1_joint"       kp="3000"  ctrlrange="-6.28319 6.28319"/>
    <position name="wrist_2"       joint="wrist_2_joint"       kp="3000"  ctrlrange="-6.28319 6.28319"/>
    <position name="wrist_3"       joint="wrist_3_joint"       kp="1500"  ctrlrange="-6.28319 6.28319"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 -1.5708 0 0 0 0" ctrl="0 -1.5708 0 0 0 0"/>
  </keyframe>

</mujoco>
