<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur20">

  <!-- UR macro from ur_description package -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- ros2_control hardware declaration -->
  <xacro:include filename="$(find wm_ur20_description)/urdf/ur20_ros2_control.xacro"/>

  <!-- Fixed world base link -->
  <link name="world"/>

  <!-- Conveyor belt link — dummy link so mujoco_system can find belt_slide in the URDF -->
  <link name="belt_link"/>
  <joint name="belt_slide" type="prismatic">
    <parent link="world"/>
    <child link="belt_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="2000" velocity="1.0"/>
  </joint>

  <!-- Instantiate UR20 — generate_ros2_control_tag=false so we supply our own block -->
  <xacro:ur_robot
    name="ur20"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur20/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur20/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur20/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur20/visual_parameters.yaml"
    generate_ros2_control_tag="false"
    use_fake_hardware="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- MujocoSystem ros2_control hardware plugin -->
  <xacro:ur20_ros2_control name="ur20_hardware"/>

</robot>
